# Gradle / Android 构建产物
.gradle/
build/
*/build/
local.properties
gradle-app.setting
.cxx/

# APK / 签名材料（绝不入库）
*.apk
*.aab
*.ap_
*.dex
*.jks
*.keystore
*.pepk
*.signature

# 凭据 / token / 配置文件（含明文的都不入库）
*credential*
*token*
*.pem
*.key
config.json
gitee_config.sh

# distribution 目录是给 Gitee 应用内更新用的：APK 清单必须入库才能被手机下载
# 这里单独放行该目录下的 APK，其余位置仍旧全部忽略
!distribution/*.apk

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# macOS / 系统
.DS_Store
Thumbs.db

# 日志
*.log
